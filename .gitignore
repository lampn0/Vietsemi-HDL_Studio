# ---------------------------------------------------------------------------------------------
# HDL Studio - files git must never track
# ---------------------------------------------------------------------------------------------

# Python byte code and local virtual environments
__pycache__/
*.pyc
.venv/
venv/

# Packaging output (PyInstaller, see scripts/README.md)
build/
dist/
*.zip

# Editor settings
.vscode/
.idea/

# Files the legacy tool / HDL Studio create next to a design (locks, caches, backups)
*.lck
*.bak
.hdlsidedata/
.xrf/
*.cache.dat

# Test output: screenshots and scratch projects, regenerated by the test scripts.
tests/gui/out/
